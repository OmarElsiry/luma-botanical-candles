{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile and delivery address isolated per authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "emailVerified": {
          "type": "boolean"
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "firstName", "surname", "email", "emailVerified", "createdAt", "updatedAt"]
    },
    "CustomCandleDesign": {
      "title": "CustomCandleDesign",
      "description": "Saved bespoke candle configuration built on the Design Your Candle studio page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "vesselColorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "vesselColorHex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "scentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "customText": {
          "type": "string",
          "maxLength": 32
        },
        "customSubtext": {
          "type": "string",
          "maxLength": 32
        },
        "fontId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "inkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "vesselColorId", "vesselColorHex", "scentId", "fontId", "inkId", "createdAt"]
    },
    "CustomSmoothieBlend": {
      "title": "CustomSmoothieBlend",
      "description": "Saved Build Your Blend smoothie recipe (up to 3 fruit bases, toppings, sweetness level, cup label) per verified user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fruits": {
          "type": "array",
          "description": "1 to 3 fruit base identifiers"
        },
        "toppings": {
          "type": "array",
          "description": "0 to 6 topping identifiers"
        },
        "sweetness": {
          "type": "number",
          "enum": [0, 25, 50, 75, 100]
        },
        "size": {
          "type": "string",
          "enum": ["12oz", "16oz", "pack3"]
        },
        "customText": {
          "type": "string",
          "maxLength": 28
        },
        "fontId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "fruits", "toppings", "sweetness", "size", "fontId", "createdAt"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Cash-on-Delivery (COD) order record owned by a verified customer.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 40
        },
        "shippingAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "deliveryNotes": {
          "type": "string",
          "maxLength": 240
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "cod-pos"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Cash Due on Delivery"]
        },
        "subtotal": {
          "type": "number"
        },
        "shipping": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "itemsSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "firstName",
        "surname",
        "customerName",
        "customerEmail",
        "customerPhone",
        "shippingAddress",
        "paymentMethod",
        "paymentStatus",
        "subtotal",
        "shipping",
        "total",
        "itemCount",
        "itemsSummary",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile containing PII (firstName, surname, email, phone, address). Restricted strictly to owner."
    },
    "/users/{userId}/designs/{designId}": {
      "schema": { "$ref": "#/entities/CustomCandleDesign" },
      "description": "Saved custom candle designs per customer, gated by parent user document."
    },
    "/users/{userId}/blends/{blendId}": {
      "schema": { "$ref": "#/entities/CustomSmoothieBlend" },
      "description": "Saved Build Your Blend smoothie configurations per customer, gated by parent user document."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Cash-on-Delivery order records owned by verified authenticated customers."
    }
  }
}
